# Ignore the entire PyCharm settings folder
.idea/

# Ignore project-specific module files
*.iml

# Ignore Python virtual environments
venv/
env/
ENV/

# Ignore Python bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore local database (if using Django/SQLite)
db.sqlite3

# Ignore environment variables/secrets
.env